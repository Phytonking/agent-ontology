{
  "name": "ontolayer",
  "version": "0.2.0",
  "description": "Filesystem-first, agent-editable ontology framework. Run it as a service (Docker/VM); point any MCP agent at a folder of markdown files it reads, edits, and serves data through.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "author": "Avi Agola",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phytonking/agent-ontology.git"
  },
  "homepage": "https://github.com/Phytonking/agent-ontology#readme",
  "bugs": {
    "url": "https://github.com/Phytonking/agent-ontology/issues"
  },
  "bin": {
    "ontology": "dist/cli.js"
  },
  "files": [
    "dist",
    "spec",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ontology",
    "agent",
    "mcp",
    "knowledge-graph",
    "llm",
    "neuro-symbolic",
    "ai-agent",
    "semantic-layer",
    "model-context-protocol"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "pg": "^8.23.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
